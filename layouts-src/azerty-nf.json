 "how": {
  "ù": "AltGr + U",
  "-": "touche - (à droite du P)",
  "'": "touche ' (à droite du 0), sans Maj",
  "â": "touche ^ (à gauche de Retour arrière), puis la voyelle",
  "î": "touche ^ (à gauche de Retour arrière), puis la voyelle",
  "ô": "touche ^ (à gauche de Retour arrière), puis la voyelle",
  "û": "touche ^ (à gauche de Retour arrière), puis la voyelle",
  "ê": "Maj + touche 4",
  "ë": "Maj + touche ^ (à gauche de Retour arrière), puis la voyelle",
  "ï": "Maj + touche ^ (à gauche de Retour arrière), puis la voyelle",
  "@": "touche à gauche du 1",
  "#": "Maj + touche à gauche du 1",
  "[": "AltGr + 5",
  "]": "AltGr + 6",
  "|": "AltGr + L",
  "/": "touche / (à droite du M)",
  "*": "touche * (à droite du /)",
  "=": "Maj + ;",
  "+": "touche + (en haut à droite)",
  "%": "AltGr + P",
  "_": "AltGr + 8",
  "{": "AltGr + T",
  "}": "AltGr + Y",
  "<": "touche < (à gauche du W)",
  ">": "Maj + <",
  "\"": "Maj + touche ' (à droite du 0)",
  "~": "AltGr + N",
  "\\": "Maj + /",
  "`": "AltGr + è, puis espace",
  "(": "touche 5",
  ")": "touche 6",
  "«": "touche 9",
  "»": "touche 0",
  "œ": "AltGr + O",
  "æ": "AltGr + A",
  "É": "AltGr + Maj + é. Maj + é donne « 2 » : c'est accepté"
