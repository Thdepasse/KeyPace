 "how": {
  "ù": "touche ù (à droite du M)",
  "-": "touche - (à droite du ), sans Maj)",
  "â": "touche ^ (à droite du P), puis la voyelle",
  "î": "touche ^ (à droite du P), puis la voyelle",
  "ô": "touche ^ (à droite du P), puis la voyelle",
  "û": "touche ^ (à droite du P), puis la voyelle",
  "ê": "touche ^ (à droite du P), puis la voyelle",
  "ë": "Maj + touche ^ (à droite du P), puis la voyelle",
  "ï": "Maj + touche ^ (à droite du P), puis la voyelle",
  "@": "touche à gauche du 1",
  "#": "Maj + touche à gauche du 1",
  "[": "Option + Maj + 5",
  "]": "Option + Maj + ) (touche à droite du 0)",
  "|": "Option + Maj + L",
  "/": "Maj + :",
  "*": "Maj + $",
  "=": "touche = (rangée du bas, à droite)",
  "+": "Maj + =",
  "%": "Maj + ù",
  "_": "Maj + -",
  "{": "Option + 5",
  "}": "Option + ) (touche à droite du 0)",
  "<": "touche < (à gauche du W)",
  ">": "Maj + <",
  "\"": "touche 3, sans Maj",
  "~": "Option + Maj + N",
  "\\": "Option + Maj + :",
  "`": "touche accent grave, puis espace",
  "(": "touche 5, sans Maj",
  ")": "touche ) (à droite du 0), sans Maj",
  "«": "Option + 7",
  "»": "Option + Maj + 7",
  "œ": "Option + O",
  "æ": "Option + A",
  "É": "Option + Maj + é. Maj + é donne « 2 » : c'est accepté"
 }
